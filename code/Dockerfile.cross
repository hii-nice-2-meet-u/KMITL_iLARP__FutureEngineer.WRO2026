FROM debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive

# =========================================================
# 1. Cross compiler environment
# =========================================================

ENV GNU_HOST=aarch64-linux-gnu

ENV C_COMPILER_ARM_LINUX=${GNU_HOST}-gcc
ENV CXX_COMPILER_ARM_LINUX=${GNU_HOST}-g++

ENV CROSS_INSTALL_PREFIX=/usr/${GNU_HOST}

ENV CROSS_TOOLCHAIN=/arm.toolchain.cmake
ENV MESON_CROSS_TOOLCHAIN=/arm64-cross.ini


# =========================================================
# 2. CMake cross toolchain
# =========================================================

RUN printf '%s\n' \
	'set(CMAKE_SYSTEM_NAME Linux)' \
	'set(CMAKE_SYSTEM_PROCESSOR aarch64)' \
	'set(CMAKE_C_COMPILER /usr/bin/aarch64-linux-gnu-gcc)' \
	'set(CMAKE_CXX_COMPILER /usr/bin/aarch64-linux-gnu-g++)' \
	'set(CMAKE_PREFIX_PATH /usr/aarch64-linux-gnu)' \
	> "$CROSS_TOOLCHAIN"


# =========================================================
# 3. Meson cross toolchain
# =========================================================

RUN printf '%s\n' \
	'[binaries]' \
	"c = '/usr/bin/aarch64-linux-gnu-gcc'" \
	"cpp = '/usr/bin/aarch64-linux-gnu-g++'" \
	"ar = '/usr/bin/aarch64-linux-gnu-ar'" \
	"strip = '/usr/bin/aarch64-linux-gnu-strip'" \
	"pkgconfig = '/usr/bin/pkg-config'" \
	'[host_machine]' \
	"system = 'linux'" \
	"cpu_family = 'aarch64'" \
	"cpu = 'aarch64'" \
	"endian = 'little'" \
	'[paths]' \
	"prefix = '/usr/aarch64-linux-gnu'" \
	"libdir = 'lib'" \
	"includedir = 'include'" \
	'[properties]' \
	'needs_exe_wrapper = true' \
	> "$MESON_CROSS_TOOLCHAIN"


# =========================================================
# 4. Host build tools + ARM64 cross compiler
# =========================================================

RUN apt-get update \
	&& apt-get --no-install-recommends install -y \
	autoconf \
	automake \
	build-essential \
	ca-certificates \
	ccache \
	curl \
	gcc-${GNU_HOST} \
	g++-${GNU_HOST} \
	git \
	gnupg \
	libssl-dev \
	openssh-client \
	pkg-config \
	software-properties-common \
	wget \
	python3 \
	python3-pip \
	python3-setuptools \
	ninja-build \
	&& rm -rf /var/lib/apt/lists/*


RUN pip3 install \
	--break-system-packages \
	meson \
	jinja2 \
	PyYAML \
	ply


# =========================================================
# 5. ARM64 development dependencies
# =========================================================

RUN dpkg --add-architecture arm64 \
	&& apt-get update \
	&& apt-get install -y \
	libcrypt-dev:arm64 \
	libglib2.0-dev:arm64 \
	libgnutls28-dev:arm64 \
	libtiff5-dev:arm64 \
	pkg-config:arm64 \
	libexif-dev:arm64 \
	libjpeg-dev:arm64 \
	libavcodec-dev:arm64 \
	libavformat-dev:arm64 \
	libswscale-dev:arm64 \
	libv4l-dev:arm64 \
	gstreamer1.0-plugins-base:arm64 \
	libgstreamer1.0-dev:arm64 \
	libgstreamer-plugins-base1.0-dev:arm64 \
	&& rm -rf /var/lib/apt/lists/*


# =========================================================
# 6. Build libcamera for ARM64
# =========================================================

ENV LIBCAMERA_CHECKOUT=v0.7.1

RUN git clone \
	--branch "$LIBCAMERA_CHECKOUT" \
	--depth=1 \
	https://github.com/raspberrypi/libcamera.git \
	/libcamera \
	&& cd /libcamera \
	&& export PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
	&& meson setup build \
	--cross-file "$MESON_CROSS_TOOLCHAIN" \
	--buildtype=release \
	-Dpipelines=rpi/vc4,rpi/pisp \
	-Dipas=rpi/vc4,rpi/pisp \
	-Dv4l2=enabled \
	-Dgstreamer=enabled \
	-Dtest=false \
	-Dlc-compliance=disabled \
	-Dcam=disabled \
	-Dqcam=disabled \
	-Ddocumentation=disabled \
	-Dpycamera=disabled \
	-Dwerror=false \
	-Dcpp_args="-Wno-error" \
	&& ninja -C build install \
	&& rm -rf /libcamera


# =========================================================
# 7. Install CMake
# =========================================================

ENV CMAKE_VERSION=3.31.6

RUN wget \
	--progress=bar:force:noscroll \
	"https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.sh" \
	&& chmod +x \
	"cmake-${CMAKE_VERSION}-linux-x86_64.sh" \
	&& "./cmake-${CMAKE_VERSION}-linux-x86_64.sh" \
	--skip-license \
	--prefix=/usr/local \
	&& rm \
	"cmake-${CMAKE_VERSION}-linux-x86_64.sh"


# =========================================================
# 8. Build OpenCV for ARM64
# =========================================================

ENV OPENCV_CHECKOUT=4.10.0

RUN OCV_DIR=/ocv \
	&& git clone \
	--branch "$OPENCV_CHECKOUT" \
	--depth=1 \
	https://github.com/opencv/opencv.git \
	"$OCV_DIR/opencv" \
	&& git clone \
	--branch "$OPENCV_CHECKOUT" \
	--depth=1 \
	https://github.com/opencv/opencv_contrib.git \
	"$OCV_DIR/opencv_contrib" \
	&& cmake \
	-S "$OCV_DIR/opencv" \
	-B "$OCV_DIR/opencv/build" \
	-G Ninja \
	-DCMAKE_TOOLCHAIN_FILE="$CROSS_TOOLCHAIN" \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_PREFIX=/usr/aarch64-linux-gnu \
	-DCMAKE_C_COMPILER=/usr/bin/$C_COMPILER_ARM_LINUX \
	-DCMAKE_CXX_COMPILER=/usr/bin/$CXX_COMPILER_ARM_LINUX \
	-DOPENCV_EXTRA_MODULES_PATH="$OCV_DIR/opencv_contrib/modules" \
	-DENABLE_NEON=ON \
	-DWITH_OPENMP=ON \
	-DWITH_OPENCL=OFF \
	-DBUILD_TIFF=ON \
	-DWITH_FFMPEG=ON \
	-DWITH_TBB=ON \
	-DBUILD_TBB=ON \
	-DWITH_GSTREAMER=ON \
	-DBUILD_TESTS=OFF \
	-DWITH_EIGEN=OFF \
	-DWITH_V4L=ON \
	-DWITH_LIBV4L=ON \
	-DWITH_VTK=OFF \
	-DWITH_QT=OFF \
	-DWITH_PROTOBUF=ON \
	-DOPENCV_ENABLE_NONFREE=ON \
	-DINSTALL_C_EXAMPLES=OFF \
	-DINSTALL_PYTHON_EXAMPLES=OFF \
	-DOPENCV_FORCE_LIBATOMIC_COMPILER_CHECK=1 \
	-DOPENCV_GENERATE_PKGCONFIG=ON \
	-DBUILD_EXAMPLES=OFF \
	&& cmake \
	--build "$OCV_DIR/opencv/build" \
	--parallel \
	&& cmake \
	--install "$OCV_DIR/opencv/build" \
	&& rm -rf "$OCV_DIR"


# =========================================================
# 9. ccache defaults
# =========================================================

ENV CCACHE_COMPRESS=true
ENV CCACHE_MAXSIZE=5G